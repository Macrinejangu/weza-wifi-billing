# Local development only.
# Never commit real credentials or production secrets.

# PostgreSQL
POSTGRES_DB=weza
POSTGRES_USER=weza
POSTGRES_PASSWORD=weza_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://weza:weza_local_only@127.0.0.1:5432/weza


# --- Daraja (M-Pesa Express) SANDBOX settings ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=replace-with-sandbox-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-sandbox-consumer-secret
DARAJA_SHORTCODE=replace-with-sandbox-shortcode
DARAJA_PASSKEY=replace-with-sandbox-passkey

DARAJA_CALLBACK_URL=https://replace-with-your-public-url/api/payments/mpesa/callback/replace-with-your-callback-token

# paybill (default) or till. Sandbox testing uses paybill.
DARAJA_ACCOUNT_TYPE=paybill
# Only for till: the number that receives the money (PartyB). Not needed for paybill.
# DARAJA_PARTY_B=

# WEZA backend API authentication
WEZA_API_KEY=replace_with_a_long_random_secret

# MikroTik router connection
# Lab: standard API on port 8728 with TLS disabled.
# Production: use API-SSL on port 8729 with TLS enabled.

ROUTER_HOST=192.0.2.10
ROUTER_PORT=8728
ROUTER_USERNAME=replace_with_router_username
ROUTER_PASSWORD=replace_with_router_password
ROUTER_TIMEOUT=5

# Router security
ROUTER_USE_SSL=false
ROUTER_TLS_CA_FILE=
ROUTER_TLS_SERVER_NAME=
EXPECTED_ROUTER_IDENTITY=replace_with_expected_router_identity

# Local purchase, payment, session and package-management simulator
ENABLE_MOCK_PAYMENTS=false

# Set a unique random secret of at least 32 characters before enabling staff login.
JWT_SECRET=

# Enable only for a direct hotspot-to-backend checkout on the isolated test network.
# Start Uvicorn with --no-proxy-headers. Leave disabled behind NAT or a proxy.
ENABLE_DIRECT_HOTSPOT_CHECKOUT=false

# Secret path segment for the Daraja callback URL. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DARAJA_CALLBACK_URL must END with this value (https://<tunnel-host>/api/payments/mpesa/callback/<token>).
# The placeholder below is deliberately too short: the app refuses to use it.
DARAJA_CALLBACK_TOKEN=change-me
# Optional source-IP check. Keep false until Safaricom's sandbox IPs are verified.
CALLBACK_IP_CHECK_ENABLED=false
# Comma-separated proxy addresses whose X-Forwarded-For header we trust. Usually empty.
CALLBACK_TRUSTED_PROXIES=